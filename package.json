{
  "name": "advanced-to-do_list-backend",
  "version": "1.0.0",
  "description": "Backend da **Plataforma de Gestão de Tarefas (To-Do App Avançado)**.",
  "main": "dist/server.js",
  "_moduleAliases": {
    "@": "dist"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "start": "node -r module-alias/register dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "prepare": "husky install",
    "commit": "cz",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./src/infrastructure/persistence/typeorm/data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d ./src/infrastructure/persistence/typeorm/data-source.ts",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate ./src/infrastructure/persistence/typeorm/migrations -d ./src/infrastructure/persistence/typeorm/data-source.ts"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.2",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "commitizen": "^4.3.1",
    "cors": "^2.8.6",
    "cz-git": "^1.12.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "nodemailer": "^8.0.1",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/nodemailer": "^7.0.11",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3"
  }
}
